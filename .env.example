# Nebius Token Factory (required): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily (recommended, free tier works): https://tavily.com
TAVILY_API_KEY=

# Model IDs: confirm with GET {NEBIUS_BASE_URL}models
MODEL_LIGHTNING=nvidia/Nemotron-3_5-Lightning
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
ENABLE_ULTRA=true            # Ultra only ever runs on an explicit "Deep analysis" click

DAILY_APPLICATION_CAP=10

# Storage. Leave Supabase blank to use local files in .data/ (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects the overnight watch endpoint (/api/cron/watch)
CRON_SECRET=

# Optional: pin storage explicitly (takes precedence over SUPABASE_* injected by integrations)
CALLBACK_SUPABASE_URL=
CALLBACK_SUPABASE_SERVICE_ROLE_KEY=
